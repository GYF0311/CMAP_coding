{
  "name": "cmap",
  "version": "0.2.0",
  "description": "Repo-local project memory map CLI for AI coding",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GYF0311/CMAP_coding.git"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "bin": {
    "cmap": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --dts",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "pnpm build && node scripts/smoke-test.mjs",
    "prepack": "pnpm build && pnpm test && pnpm typecheck && pnpm smoke"
  },
  "dependencies": {
    "commander": "14.0.3",
    "gray-matter": "4.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.6.2",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  },
  "packageManager": "pnpm@10.32.1"
}
